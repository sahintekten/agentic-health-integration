# Copy this file to .env and fill in the values. Never commit .env.

# Which LLM the agents use: gemini, claude_code, anthropic or azure_openai
LLM_PROVIDER=gemini

# Google AI Studio key (for gemini). Model ids can be changed here.
GEMINI_API_KEY=
GEMINI_MODEL_STRONG=gemini-3.8-flash,gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# set to 0 to turn off the LLM disk cache
LLM_CACHE=1

ANTHROPIC_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_MINI=

# Local mock lab database (leave empty to use the docker-compose defaults)
LAB_DB_USER=
LAB_DB_PASSWORD=
