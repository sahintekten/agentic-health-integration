# Copy this file to .env and fill in the values. Never commit .env.

# Which LLM the agents use (phase 2): anthropic or azure_openai
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_MINI=

# Local mock lab database (leave empty to use the docker-compose defaults)
LAB_DB_USER=
LAB_DB_PASSWORD=
