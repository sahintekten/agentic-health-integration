# Copy this file to .env and fill in the values. Never commit .env.

# Which LLM the agents use: github_models, claude_code, anthropic or azure_openai
LLM_PROVIDER=github_models

# GitHub personal access token with the models:read permission (for github_models)
GITHUB_TOKEN=

# set to 0 to turn off the LLM disk cache
LLM_CACHE=1

ANTHROPIC_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_MINI=

# Local mock lab database (leave empty to use the docker-compose defaults)
LAB_DB_USER=
LAB_DB_PASSWORD=
